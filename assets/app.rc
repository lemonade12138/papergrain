// PaperGrain resources (compiled with windres / rc.exe)
#include <winver.h>

1 ICON "assets/icon.ico"
1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "CookieFilled"
      VALUE "FileDescription",  "PaperGrain - Paper Texture Overlay"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "PaperGrain"
      VALUE "LegalCopyright",   "(c) 2026 CookieFilled - MIT License"
      VALUE "OriginalFilename", "PaperGrain.exe"
      VALUE "ProductName",      "PaperGrain"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
